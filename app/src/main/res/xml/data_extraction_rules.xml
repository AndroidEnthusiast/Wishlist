<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer (owner, 12 November 2026, P20): Wishlist's data is never copied by Android, neither to the
     Google account's backup nor straight to a new phone during its setup. A new phone uses the recovery key instead
     (Restore.kt), which signs out the old phone; a copy made by Android would give two phones the same secret codes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
